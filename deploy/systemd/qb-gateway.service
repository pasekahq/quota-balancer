# quota-balancer model gateway (template, user unit). Runs as the owner of the credentials in its
# config, serves /v1/model/* and the HTTP fronts (/v1/messages, /v1/chat/completions,
# /v1/responses) on its own socket, the HTTP fronts also on an optional loopback port, and asks
# qbd where each turn runs. Install into ~/.config/systemd/user/ of that
# user. The process makes itself non-dumpable and applies landlock itself (credential
# directories and its spend, audit and usage files' directories, its config's directory
# read-only, resolver files, TCP connect to 443, TCP bind on the loopback port only), so the
# unit's system call filter allows the landlock calls on top of @system-service. The socket goes
# into RuntimeDirectory, for example socket = "/run/user/<uid>/qb-gateway/gateway.sock" in the
# config. Mode 0700 admits only this user; for [[clients]] of other uids use 0750 with a shared
# group and socket_mode 0o660.
[Unit]
Description=quota-balancer model gateway
Documentation=https://github.com/vladmesh/quota-balancer

[Service]
Type=simple
WorkingDirectory=~
RuntimeDirectory=qb-gateway
RuntimeDirectoryMode=0700
ExecStart=%h/.local/bin/qb gateway --config %h/.config/qb/gateway.toml
# SIGHUP reloads the config (docs/config.md, "Reload"); a refused one keeps the running config.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes
# Namespace-based sandboxing in user units needs unprivileged user namespaces, which some
# distributions restrict. Enable where available:
#ProtectSystem=strict
#ProtectHome=read-only
#PrivateTmp=yes
UMask=0077
# max_turns x (2 x max_request_bytes + 1 MiB) + 4 MiB is 72 MiB for the defaults; 96M adds a third
# as headroom. Raise with max_turns or max_request_bytes.
MemoryMax=96M
# The main thread and up to max_turns + 2 connection threads (turns, then routes, cancel and
# health), 7 for the defaults, plus one for a connection thread still exiting. Host names resolve
# on the turn's own thread, so an upstream connect starts no thread; a connection whose thread
# cannot start is dropped with a warning. Raise with max_turns.
TasksMax=8

[Install]
WantedBy=default.target
