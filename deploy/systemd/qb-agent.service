# quota-balancer agent (template, user unit). Runs as the owner of the vendor CLI credentials,
# connects to qbd itself and answers lazy probes with window numbers only. Install into
# ~/.config/systemd/user/ of that user. The process makes itself non-dumpable and applies landlock
# itself, so the unit's system call filter allows the landlock calls on top of @system-service.
[Unit]
Description=quota-balancer agent
Documentation=https://github.com/pasekahq/quota-balancer

[Service]
Type=simple
Environment=QB_SOCKET=/run/qb/qb.sock
WorkingDirectory=~
ExecStart=%h/.local/bin/qb agent --config %h/.config/qb/agent.toml
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes
# Namespace-based sandboxing in user units needs unprivileged user namespaces, which some
# distributions restrict. Enable where available:
#ProtectSystem=strict
#ProtectHome=read-only
#PrivateTmp=yes
UMask=0077
MemoryMax=32M
TasksMax=4

[Install]
WantedBy=default.target
