{
  "openapi": "3.1.0",
  "info": {
    "title": "qb model gateway (C4)",
    "version": "1.0.0",
    "description": "The model gateway of quota-balancer, `qb gateway`: one model turn per request on a route alias, streamed as NDJSON events. The gateway picks a login through qbd, holds and refreshes its credential, moves to another login before the client has seen any event, and reports what it observed to qbd. Invariants: thinking blocks of another vendor than the picked one are dropped; tool-call ids pass through unchanged; vendor identity headers and prompt prefixes are added by the gateway, never by the client. Decisions: docs/adr/0001-model-gateway.md; prose contract: docs/api.md."
  },
  "x-transport": {
    "protocol": "HTTP/1.1 over a SOCK_STREAM unix socket, one request per connection; the peer is identified by SO_PEERCRED and must be the gateway's own uid or a configured client uid (else 401)",
    "request": "JSON body with `Content-Length`, at most `max_request_bytes` (413 above); chunked request bodies are rejected",
    "stream": "`POST /v1/model/turn` answers `200` with `Transfer-Encoding: chunked` and `Content-Type: application/x-ndjson`, one `StreamEvent` per line; the head goes out together with the first event",
    "error": "a request rejected before the turn starts gets a non-200 status with `Error` as the JSON body; every admitted turn is a `200` stream ending with exactly one `stop` or `error` event"
  },
  "paths": {
    "/v1/model/turn": {
      "post": {
        "operationId": "turn",
        "summary": "Run one model turn on a route alias and stream its events.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Chunked NDJSON stream, one `StreamEvent` per line, ending with exactly one `stop` or `error`.",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "$ref": "#/components/schemas/StreamEvent"
                }
              }
            }
          },
          "default": {
            "description": "Rejected before the turn started: 400 invalid, 401 caller not allowed, 411 no Content-Length, 413 body too large, 429 turn or connection cap reached (`overloaded`, `retry_after`). `class` is authoritative, the status is informative.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/model/routes": {
      "get": {
        "operationId": "routes",
        "summary": "Route aliases and their state.",
        "responses": {
          "200": {
            "description": "Routes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoutesAnswer"
                }
              }
            }
          },
          "default": {
            "description": "Rejected before any work started; `class` is authoritative, the status is informative.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/model/cancel": {
      "post": {
        "operationId": "cancel",
        "summary": "Stop a running turn this caller started; 404 when none runs with that id, 403 when another caller started it.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Outcome.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelAnswer"
                }
              }
            }
          },
          "default": {
            "description": "Rejected before any work started; `class` is authoritative, the status is informative.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/model/reload": {
      "post": {
        "operationId": "reload",
        "summary": "Read the gateway's config file again; only the gateway's own uid, 403 for any other caller. A config that parses and validates as at startup and changes no restart-only field serves every later turn; turns already admitted finish on theirs. A refusal is 400 `bad_request` whose message names the file and the field or line, and the running config stays. The body is ignored.",
        "responses": {
          "200": {
            "description": "The new config serves.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReloadAnswer"
                }
              }
            }
          },
          "default": {
            "description": "Refused; `class` is authoritative, the status is informative.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness and version, as qbd answers it.",
        "responses": {
          "200": {
            "description": "Serving.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TurnRequest": {
        "type": "object",
        "description": "Body of `POST /v1/model/turn`: one model turn on a route alias. The client sends no vendor identity headers and no vendor prompt prefixes; qb adds them for the vendor it picks.",
        "properties": {
          "route": {
            "type": "string",
            "description": "Route alias from the gateway config; it maps to a qbd role and ladder step, or to a pinned vendor and model.",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "system": {
            "type": "string",
            "description": "System prompt of the client, without any vendor prefix."
          },
          "messages": {
            "type": "array",
            "description": "Conversation, oldest first.",
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "minItems": 1
          },
          "tools": {
            "type": "array",
            "description": "Tools the model may call.",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "max_tokens": {
            "type": "integer",
            "description": "Upper bound of output tokens for this turn.",
            "minimum": 1
          },
          "effort": {
            "$ref": "#/components/schemas/Effort"
          },
          "session_key": {
            "type": "string",
            "description": "Opaque session id: the `run_id` and `resume_of` of qbd's pick, so a session stays on one login where qbd can keep it there.",
            "minLength": 1,
            "maxLength": 128
          },
          "cache": {
            "$ref": "#/components/schemas/CacheMode"
          },
          "request_id": {
            "type": "string",
            "description": "Client-chosen id of this turn, unique among running turns; `POST /v1/model/cancel` names it.",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        },
        "required": [
          "route",
          "messages",
          "max_tokens",
          "request_id"
        ],
        "additionalProperties": false
      },
      "Effort": {
        "type": "string",
        "description": "Reasoning effort; qb maps it to the vendor setting of the picked model.",
        "enum": [
          "low",
          "medium",
          "high",
          "max"
        ]
      },
      "CacheMode": {
        "type": "string",
        "description": "Prompt cache policy; `auto` lets qb place cache breakpoints for the picked vendor.",
        "enum": [
          "auto"
        ]
      },
      "Role": {
        "type": "string",
        "description": "Author of a message; tool results travel in `user` messages.",
        "enum": [
          "user",
          "assistant"
        ]
      },
      "Message": {
        "type": "object",
        "description": "One conversation message.",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "content": {
            "type": "array",
            "description": "Blocks in order.",
            "items": {
              "$ref": "#/components/schemas/Block"
            },
            "minItems": 1
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      },
      "BlockType": {
        "type": "string",
        "description": "Kind of a message block.",
        "enum": [
          "text",
          "image",
          "tool_use",
          "tool_result",
          "thinking"
        ]
      },
      "MediaType": {
        "type": "string",
        "description": "Media type of an image.",
        "enum": [
          "image/png",
          "image/jpeg",
          "image/gif",
          "image/webp"
        ]
      },
      "Block": {
        "type": "object",
        "description": "One message block: `type` selects the variant and its fields. `text`: `text`. `image`: `media_type` and exactly one of `path` and `base64`. `tool_use`: `id`, `name`, `input`. `tool_result`: `id`, `content`, optional `is_error`. `thinking`: `vendor`, `opaque`, echoed back as received; qb drops `thinking` blocks of another vendor after a cross-vendor fallback.",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/BlockType"
          },
          "text": {
            "type": "string",
            "description": "Text (`text`)."
          },
          "media_type": {
            "$ref": "#/components/schemas/MediaType"
          },
          "path": {
            "type": "string",
            "description": "Absolute path of a local image file (`image`). Part of the contract's shape; `qb gateway` reads no file a client names and answers 400 for it, so images go inline as `base64`.",
            "pattern": "^/"
          },
          "base64": {
            "type": "string",
            "description": "Standard base64 of the image bytes (`image`).",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "description": "Tool-call id (`tool_use`, `tool_result`); qb keeps it stable across vendors.",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "description": "Tool name (`tool_use`).",
            "minLength": 1
          },
          "input": {
            "type": "object",
            "description": "Tool arguments (`tool_use`)."
          },
          "content": {
            "type": "string",
            "description": "Tool output as text (`tool_result`)."
          },
          "is_error": {
            "type": "boolean",
            "description": "The tool failed (`tool_result`); absent means false."
          },
          "vendor": {
            "type": "string",
            "description": "Vendor that produced the thinking (`thinking`): the qb vendor name the `route` event named.",
            "minLength": 1
          },
          "opaque": {
            "type": "string",
            "description": "Vendor thinking payload, passed back unchanged (`thinking`)."
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "text"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "text"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "image"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "media_type"
              ],
              "oneOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "base64"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "tool_use"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "id",
                "name",
                "input"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "tool_result"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "id",
                "content"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "thinking"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "vendor",
                "opaque"
              ]
            }
          }
        ]
      },
      "Tool": {
        "type": "object",
        "description": "A tool the model may call.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Tool name, unique within the request.",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "description": {
            "type": "string",
            "description": "What the tool does, for the model."
          },
          "input_schema": {
            "type": "object",
            "description": "JSON Schema of the tool arguments."
          }
        },
        "required": [
          "name",
          "description",
          "input_schema"
        ],
        "additionalProperties": false
      },
      "EventType": {
        "type": "string",
        "description": "Kind of a stream event; `stop` and `error` are terminal.",
        "enum": [
          "route",
          "text_delta",
          "thinking",
          "tool_call",
          "usage",
          "stop",
          "error"
        ]
      },
      "StreamEvent": {
        "type": "object",
        "description": "One NDJSON line of the turn stream: `type` and the one payload field of that variant (`route`: `route`, `text_delta`: `text`, `thinking`: `thinking`, `tool_call`: `tool_call`, `usage`: `usage`, `stop`: `reason`, `error`: `error`). A stream carries `route`, then any number of `text_delta`, `thinking`, `tool_call` and `usage` events, and ends with exactly one `stop` or `error`; a turn that fails before any vendor answered is one `error` without `route`. A stream that ends without a final event was cut by a transport failure.",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/EventType"
          },
          "route": {
            "$ref": "#/components/schemas/RouteInfo"
          },
          "text": {
            "type": "string",
            "description": "Next piece of the answer text (`text_delta`)."
          },
          "thinking": {
            "$ref": "#/components/schemas/Thinking"
          },
          "tool_call": {
            "$ref": "#/components/schemas/ToolCall"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "reason": {
            "$ref": "#/components/schemas/StopReason"
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "maxProperties": 2,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "route"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "route"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "text_delta"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "text"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "thinking"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "thinking"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "tool_call"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "tool_call"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "usage"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "usage"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "stop"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "error"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "error"
              ]
            }
          }
        ]
      },
      "RouteInfo": {
        "type": "object",
        "description": "Where the gateway runs this turn; sent with the first content event of the attempt that answers.",
        "properties": {
          "vendor": {
            "type": "string",
            "description": "qb vendor name from qbd's config.",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "description": "Vendor model id.",
            "minLength": 1
          },
          "login_label": {
            "type": "string",
            "description": "Name of the login qbd picked; never a credential.",
            "minLength": 1
          },
          "lease": {
            "type": "string",
            "description": "qbd lease id of the attempt.",
            "minLength": 1
          }
        },
        "required": [
          "vendor",
          "model",
          "login_label",
          "lease"
        ]
      },
      "Thinking": {
        "type": "object",
        "description": "A complete thinking block; the client stores it and echoes it back as a `thinking` block of the assistant message.",
        "properties": {
          "vendor": {
            "type": "string",
            "description": "qb vendor name of the route that produced it.",
            "minLength": 1
          },
          "opaque": {
            "type": "string",
            "description": "Vendor thinking payload, passed back unchanged."
          }
        },
        "required": [
          "vendor",
          "opaque"
        ]
      },
      "ToolCall": {
        "type": "object",
        "description": "A complete tool call of the model; the client echoes it back as a `tool_use` block.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Tool-call id, stable across vendors.",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "description": "Tool name from the request.",
            "minLength": 1
          },
          "input": {
            "type": "object",
            "description": "Tool arguments."
          }
        },
        "required": [
          "id",
          "name",
          "input"
        ]
      },
      "Usage": {
        "type": "object",
        "description": "Token counts of the turn so far; a later `usage` event replaces an earlier one.",
        "properties": {
          "input": {
            "type": "integer",
            "description": "Input tokens not read from cache.",
            "minimum": 0
          },
          "output": {
            "type": "integer",
            "description": "Output tokens.",
            "minimum": 0
          },
          "cache_read": {
            "type": "integer",
            "description": "Input tokens read from the prompt cache.",
            "minimum": 0
          },
          "cache_write": {
            "type": "integer",
            "description": "Input tokens written to the prompt cache.",
            "minimum": 0
          }
        },
        "required": [
          "input",
          "output",
          "cache_read",
          "cache_write"
        ]
      },
      "StopReason": {
        "type": "string",
        "description": "Why the turn ended: `end` finished, `tool_use` waits for tool results, `max_tokens` hit the limit, `refusal` declined by the model.",
        "enum": [
          "end",
          "tool_use",
          "max_tokens",
          "refusal"
        ]
      },
      "ErrorClass": {
        "type": "string",
        "description": "Failure class: `quota_exhausted` every candidate of the route waits for a reset or back-off (`resets_at` until when, retryable), `auth` a login or the caller was rejected, `unavailable` the vendor or qbd failed, `overloaded` back off (`retry_after`), `bad_request` the request is invalid, `context_too_long` the conversation does not fit the model, `cancelled` the turn was cancelled, `no_route` qbd has no candidate the route can ever run on.",
        "enum": [
          "quota_exhausted",
          "auth",
          "unavailable",
          "overloaded",
          "bad_request",
          "context_too_long",
          "cancelled",
          "no_route"
        ]
      },
      "Error": {
        "type": "object",
        "description": "A failed turn: the payload of a terminal `error` event, and the body of every non-200 answer.",
        "properties": {
          "class": {
            "$ref": "#/components/schemas/ErrorClass"
          },
          "retryable": {
            "type": "boolean",
            "description": "The same request may succeed if sent again later: after `retry_after` seconds, or at `resets_at`."
          },
          "retry_after": {
            "type": "integer",
            "description": "Seconds to wait before a retry (`overloaded`).",
            "minimum": 0
          },
          "resets_at": {
            "type": "integer",
            "description": "Unix time when the route's nearest candidate becomes usable again (`quota_exhausted`).",
            "minimum": 0
          },
          "tried": {
            "type": "array",
            "description": "Routes qb tried for this turn, in order.",
            "items": {
              "$ref": "#/components/schemas/Attempt"
            }
          },
          "message": {
            "type": "string",
            "description": "Human-readable detail, without credentials."
          }
        },
        "required": [
          "class",
          "retryable"
        ]
      },
      "Attempt": {
        "type": "object",
        "description": "One login the turn tried and how it failed.",
        "properties": {
          "vendor": {
            "type": "string",
            "description": "Vendor.",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "description": "Vendor model id.",
            "minLength": 1
          },
          "login_label": {
            "type": "string",
            "description": "Login name.",
            "minLength": 1
          },
          "class": {
            "$ref": "#/components/schemas/ErrorClass"
          }
        },
        "required": [
          "vendor",
          "model",
          "class"
        ]
      },
      "RouteState": {
        "type": "string",
        "description": "State of a route alias from the logins it can run on in qbd's state: `ready` one of them is usable, `exhausted` all usable ones wait for a reset or back-off (`resets_at`), `unavailable` none is usable or qbd is unreachable. `degraded` is reserved and not sent.",
        "enum": [
          "ready",
          "degraded",
          "exhausted",
          "unavailable"
        ]
      },
      "RouteStatus": {
        "type": "object",
        "description": "One route alias and the logins it can run on: this gateway's logins of the pinned vendor, of each step's vendor of a chain route, or every login of this gateway for a ladder route.",
        "properties": {
          "alias": {
            "type": "string",
            "description": "Route alias.",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "state": {
            "$ref": "#/components/schemas/RouteState"
          },
          "vendor": {
            "type": "string",
            "description": "Pinned vendor, or of a ready chain route the vendor of its first step with a ready login; absent for a ladder route.",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "description": "Pinned model, or of a ready chain route the model of its first step with a ready login; absent for a ladder route.",
            "minLength": 1
          },
          "resets_at": {
            "type": "integer",
            "description": "Nearest end of the marks of its logins (`exhausted`).",
            "minimum": 0
          }
        },
        "required": [
          "alias",
          "state"
        ]
      },
      "RoutesAnswer": {
        "type": "object",
        "description": "Answer of `GET /v1/model/routes`.",
        "properties": {
          "routes": {
            "type": "array",
            "description": "Route aliases, sorted by alias.",
            "items": {
              "$ref": "#/components/schemas/RouteStatus"
            }
          }
        },
        "required": [
          "routes"
        ]
      },
      "CancelRequest": {
        "type": "object",
        "description": "Body of `POST /v1/model/cancel`.",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "`request_id` of a running turn this caller started.",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false
      },
      "CancelAnswer": {
        "type": "object",
        "description": "Answer of `POST /v1/model/cancel`.",
        "properties": {
          "cancelled": {
            "type": "boolean",
            "description": "Always true: the turn was stopped and ends with an `error` event of class `cancelled`."
          }
        },
        "required": [
          "cancelled"
        ]
      },
      "ReloadAnswer": {
        "type": "object",
        "description": "Answer of `POST /v1/model/reload`: the config now serving later turns.",
        "properties": {
          "routes": {
            "type": "integer",
            "minimum": 1,
            "description": "Route aliases of the new config."
          },
          "logins": {
            "type": "integer",
            "minimum": 1,
            "description": "Logins of the new config."
          }
        },
        "required": [
          "routes",
          "logins"
        ]
      },
      "Health": {
        "type": "object",
        "description": "Answer of `GET /v1/health`.",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "description": "Serving."
          },
          "api_version": {
            "type": "string",
            "description": "`v1`."
          },
          "version": {
            "type": "string",
            "description": "Build version."
          },
          "uptime_s": {
            "type": "integer",
            "minimum": 0,
            "description": "Seconds since start."
          }
        },
        "required": [
          "status",
          "api_version",
          "version",
          "uptime_s"
        ]
      }
    }
  }
}
